[
 {
  "tag": "div",
  "cls": [
   "toolbar",
   "page-toolbar",
   "accordion",
   "expanded"
  ],
  "children": [
   {
    "tag": "label",
    "text": "Pages"
   },
   {
    "tag": "button",
    "cls": [
     "g-accordion"
    ],
    "children": [
     {
      "tag": "span",
      "cls": [
       "gravit-icon-down"
      ]
     }
    ]
   },
   {
    "tag": "div",
    "cls": [
     "g-accordion-ghost"
    ]
   },
   {
    "tag": "label",
    "cls": [
     "g-switch"
    ],
    "attrs": {
     "data-title": "Toggle Single / Multipage Mode",
     "style": "margin-right: 5px;"
    },
    "children": [
     {
      "tag": "input",
      "id": "toogle-page-mode-checkbox",
      "attrs": {
       "data-property": "multipage-switch",
       "type": "checkbox"
      },
      "props": {
       "checked": true
      },
      "hidden": true
     },
     {
      "tag": "div"
     }
    ]
   },
   {
    "tag": "button",
    "cls": [
     "setting-menu-options"
    ],
    "attrs": {
     "style": "display: none;"
    },
    "hidden": true
   },
   {
    "tag": "button",
    "attrs": {
     "data-title": "Delete Active Page"
    },
    "children": [
     {
      "tag": "span",
      "cls": [
       "gravit-icon-trash"
      ]
     }
    ]
   },
   {
    "tag": "button",
    "attrs": {
     "data-title": "Create New Page"
    },
    "children": [
     {
      "tag": "span",
      "cls": [
       "gravit-icon-addpage"
      ]
     }
    ]
   }
  ]
 }
]
