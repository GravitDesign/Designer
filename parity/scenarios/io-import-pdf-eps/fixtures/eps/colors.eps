%!PS-Adobe-3.0 EPSF-3.0
%%BoundingBox: 0 0 300 200
%%EndComments
0.5 setgray 0 0 20 20 rectfill
0.1 0.2 0.3 setrgbcolor 20 0 20 20 rectfill
0.1 0.2 0.3 0.4 setcmykcolor 40 0 20 20 rectfill
0.3 0.8 0.9 sethsbcolor 60 0 20 20 rectfill
/DeviceRGB setcolorspace 0.9 0.5 0.1 setcolor 80 0 20 20 rectfill
/DeviceCMYK setcolorspace 0 1 1 0 setcolor 100 0 20 20 rectfill
/DeviceGray setcolorspace 0.25 setcolor 120 0 20 20 rectfill
[/Indexed /DeviceRGB 2 <ff000000ff000000ff>] setcolorspace 1 setcolor 140 0 20 20 rectfill
[/Separation /Spot1 /DeviceCMYK { dup 0.5 mul exch 0 exch 0 } ] setcolorspace 0.8 setcolor 160 0 20 20 rectfill
[/DeviceN [/Cyan /Magenta] /DeviceCMYK { 0 0 } ] setcolorspace 0.3 0.6 setcolor 180 0 20 20 rectfill
[/CIEBasedABC << /WhitePoint [0.9505 1 1.089] >>] setcolorspace 0.2 0.4 0.6 setcolor 200 0 20 20 rectfill
[/Separation /All /DeviceGray { 1 exch sub } ] setcolorspace 0.7 setcolor 220 0 20 20 rectfill
[/Indexed /DeviceCMYK 1 <00ff00ff ff000000>] setcolorspace 0 setcolor 240 0 20 20 rectfill
currentgray pop currentrgbcolor pop pop pop currentcmykcolor pop pop pop pop
/DeviceRGB setcolorspace currentcolorspace pop currentcolor pop pop pop
0.2 0.3 0.4 setrgbcolor newpath 0 40 moveto 100 40 lineto 3 setlinewidth stroke
0 0 0 1 setcmykcolor newpath 0 60 moveto 100 60 lineto stroke
0.5 setgray currentrgbcolor setrgbcolor 0 80 10 10 rectfill
0.2 0.4 0.6 setrgbcolor currentgray setgray 20 80 10 10 rectfill
0.2 0.4 0.6 setrgbcolor currentcmykcolor setcmykcolor 40 80 10 10 rectfill
1 0 0 setrgbcolor currenthsbcolor sethsbcolor 60 80 10 10 rectfill
showpage
%%EOF
