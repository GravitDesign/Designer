gsave
newpath 10 10 moveto 210 10 lineto 210 110 lineto 10 110 lineto closepath clip
<< /ShadingType 2 /ColorSpace /DeviceRGB /Coords [10 0 210 0]
   /Function << /FunctionType 2 /Domain [0 1] /C0 [1 0.8 0] /C1 [0 0.2 0.8] /N 1 >>
   /Extend [true true] >> shfill
grestore
gsave
<< /ShadingType 3 /ColorSpace /DeviceRGB /Coords [110 60 0 110 60 40]
   /Function << /FunctionType 2 /Domain [0 1] /C0 [1 1 1] /C1 [0.6 0 0.6] /N 1 >> >> shfill
grestore
showpage
