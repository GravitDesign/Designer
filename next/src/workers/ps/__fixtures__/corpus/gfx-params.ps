currentcolortransfer 4 { pop } repeat {1} {2} {3} {4} setcolortransfer currenttransfer exec r {5} settransfer currenttransfer exec r
currentsystemparams length r currentpagedevice length r << >> setpagedevice 1 setuserparams << >> setuserparams
1 setoverprint currentoverprint b true setoverprint currentoverprint b count r
