%!PS
/r { 0 0 3 -1 roll 1 rectfill } def
/b { { 1 } { 0 } ifelse r } def
/s { length r } def
/e { stopped b } def
1 type length r 1.5 type length r (s) type length r /n type length r [1] type length r 1 dict type length r
true type length r null type length r /add load type length r mark type length r save type length r
currentfile type length r 1 1 1 3 packedarray type length r
{ type } e
