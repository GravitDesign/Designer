{
  "name": "gravit-designer-local",
  "version": "2.0.0",
  "private": true,
  "description": "Gravit Designer, rewritten in TypeScript",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/big.js": "^6.2.2",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/pako": "^1.0.7",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ua-parser-js": "^0.7.39",
    "@vitejs/plugin-react": "^6.1.2",
    "cross-env": "^10.1.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "pixelmatch": "^7.1.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "big.js": "6.2.2",
    "comlink": "^4.4.2",
    "express": "^5.3.0",
    "pako": "1.0.11",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ua-parser-js": "0.7.33",
    "zustand": "^5.0.15"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run build:client && npm run build:electron",
    "build:client": "tsc -p tsconfig.json && vite build",
    "build:electron": "vite build --config vite.electron.config.ts",
    "start": "node server/main.ts",
    "electron": "npm run build && electron .",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "parity": "playwright test --project parity",
    "parity:record": "cross-env GD_RECORD=1 playwright test --project parity",
    "parity:prove": "node scripts/prove-failing.ts",
    "inventory:check": "node scripts/inventory-check.ts",
    "parity:mutations": "node scripts/prove-mutations.ts"
  },
  "main": "dist-electron/main.js"
}
